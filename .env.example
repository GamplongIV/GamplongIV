# URL deployment Google Apps Script, contoh:
# https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GAS_API_URL=https://script.google.com/macros/s/ISI_DEPLOYMENT_ID/exec
# (Alternatif nama lama yang masih didukung):
# NEXT_PUBLIC_GAS_API_URL=https://script.google.com/macros/s/ISI_DEPLOYMENT_ID/exec

# Harus sama persis dengan Script Properties -> WRITE_TOKEN di Apps Script
GAS_WRITE_TOKEN=ganti_dengan_token_rahasia

# Kredensial panel admin Next.js
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_yang_kuat
